{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:mappers": "tsx scripts/test-mappers.ts",
    "test:schema": "tsx scripts/test-schema.ts",
    "test:diff": "tsx scripts/test-diff.ts",
    "test:link": "tsx scripts/test-link.ts",
    "test:tokens": "tsx scripts/test-tokens.ts",
    "test:dataUrl": "tsx scripts/test-dataUrl.ts",
    "test:repo": "tsx scripts/test-repo.ts",
    "test:gate": "tsx scripts/test-gateView.ts",
    "test:schemaCompare": "tsx scripts/test-schemaCompare.ts",
    "test:seedGuard": "tsx scripts/test-seedGuard.ts",
    "test": "npm run typecheck && npm run test:mappers && npm run test:schema && npm run test:diff && npm run test:link && npm run test:tokens && npm run test:dataUrl && npm run test:repo && npm run test:gate && npm run test:schemaCompare && npm run test:seedGuard",
    "wix:doctor": "node wix/doctor.mjs",
    "wix:setup": "node wix/setup-collections.mjs",
    "wix:setup:plan": "node wix/setup-collections.mjs --plan",
    "wix:seed": "tsx wix/seed-cms.ts",
    "wix:seed:plan": "tsx wix/seed-cms.ts --plan",
    "wix:seed:force": "tsx wix/seed-cms.ts --force"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@wix/data": "^1.0.521",
    "@wix/media": "^1.0.274",
    "@wix/members": "^1.0.519",
    "@wix/sdk": "^1.21.16",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "tsx": "^4.21.0"
  }
}
