# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Wix Headless - this is now the app's real backend
# ---------------------------------------------------------------------------

# VITE_WIX_CLIENT_ID: OAuth client ID for this frontend.
# Create it on YOUR EXISTING SITE at:
#   Settings > Development & integrations > Headless Settings > Create New Client
# PUBLIC and safe to ship in the browser bundle: Wix Headless OAuth uses PKCE,
# so no client secret is needed for visitor or member flows.
# Leave the client's "Login URL" field EMPTY (that field is for custom login
# pages only, and setting it breaks the Wix-hosted login page).
VITE_WIX_CLIENT_ID=""

# WIX_API_KEY: Admin API key, used ONLY by the one-off scripts that create the
# CMS collections and seed them (`npm run wix:setup`, `npm run wix:seed`).
# Create one at https://manage.wix.com/account/api-keys with the
# "Manage Data Collections" scope. NOT needed to build or run the app.
# Never ship it to the browser, and revoke it once the collections exist.
WIX_API_KEY=""

# WIX_SITE_ID: Your site's ID (the metasiteId from the dashboard URL).
# Required by the setup/seed scripts alongside WIX_API_KEY.
WIX_SITE_ID=""
